<Window x:Class="NorthstarBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Northstar Alpha" Height="820" Width="1380" MinHeight="620" MinWidth="920"
        Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="18"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#334155"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="76" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="SessionRail" Grid.Column="0" Background="#111827">
      <Grid Margin="10,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="NewSessionButton" Click="NewSession_Click" Content="＋" ToolTip="New session"
                FontSize="26" Foreground="White" Background="#635BFF" BorderThickness="0"
                Width="48" Height="48" Cursor="Hand" />
        <ListBox x:Name="SessionList" Grid.Row="1" Margin="0,18,0,0" Background="Transparent"
                 BorderThickness="0" SelectionChanged="SessionList_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,0,10"
                      Background="#253047" ToolTip="{Binding Name}">
                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2">
          <Button Click="Theme_Click" Content="◐" ToolTip="Switch light/dark theme" FontSize="19" Foreground="#CBD5E1"
                  Background="Transparent" BorderThickness="0" Width="48" Height="42" />
          <Button Click="Customise_Click" Content="⚙" ToolTip="Cycle Spacious, Compact and Focus layouts" FontSize="19" Foreground="#CBD5E1"
                  Background="Transparent" BorderThickness="0" Width="48" Height="42" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="48" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="ChromeBar" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
        <Grid Margin="14,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="BackButton" Click="Back_Click" Content="←" Style="{StaticResource NavButton}" />
          <Button x:Name="ForwardButton" Grid.Column="1" Click="Forward_Click" Content="→" Style="{StaticResource NavButton}" />
          <Button Grid.Column="2" Click="Reload_Click" Content="↻" Style="{StaticResource NavButton}" />
          <Border Grid.Column="3" Margin="10,0" Background="#F1F5F9" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SecurityGlyph" Text="◉" Foreground="#0F9D76" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBox x:Name="AddressBox" Grid.Column="1" KeyDown="AddressBox_KeyDown" BorderThickness="0"
                       Background="Transparent" VerticalContentAlignment="Center" FontSize="14" />
              <Button Grid.Column="2" Click="Go_Click" Content="↵" Background="Transparent" BorderThickness="0" Cursor="Hand" />
            </Grid>
          </Border>
          <Button Grid.Column="4" Click="NewTab_Click" Content="＋" Style="{StaticResource NavButton}" ToolTip="New page" />
          <Button Grid.Column="5" Click="Privacy_Click" Content="◈" Style="{StaticResource NavButton}" ToolTip="Privacy status" />
        </Grid>
      </Border>

      <Border x:Name="WorkspaceBar" Grid.Row="1" Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
        <Grid Margin="14,5">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="WorkspaceTitle" Text="WORKSPACE" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
          <Button x:Name="GroupButton" Grid.Column="1" Click="GroupTab_Click" Content="Group" Padding="14,6" Margin="4,0" ToolTip="Move this page to another group" />
          <ToggleButton x:Name="SplitToggle" Grid.Column="2" Click="SplitToggle_Click" Content="Split view" Padding="14,6" Margin="4,0" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" Background="White">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="TabColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="VerticalTabsPanel" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
          <ListBox x:Name="TabStrip" SelectionChanged="TabStrip_SelectionChanged" DisplayMemberPath="DisplayTitle"
                   Background="Transparent" BorderThickness="0" Margin="8" Padding="2" />
        </Border>
        <Grid x:Name="BrowserHost" Grid.Column="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
          <Grid x:Name="PrimaryHost" Grid.Column="0" Background="White" />
          <GridSplitter x:Name="SplitDivider" Grid.Column="1" Width="5" Background="#CBD5E1" Visibility="Collapsed" />
          <Grid x:Name="SecondaryHost" Grid.Column="2" Background="White" Visibility="Collapsed" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>

</Window>
